@model CatalogViewModel

<h2>Каталог товаров</h2>

<!-- Автопоиск -->
<div class="search-wrapper mx-auto mb-4 position-relative">
    <input type="text" id="searchBox" class="form-control ps-5" placeholder="Поиск по названию..." autocomplete="off" />
    <i class="bi bi-search search-icon"></i>
    <div id="suggestions" class="list-group position-absolute"></div>
</div>

<div class="catalog-container">
    <!-- Фильтры -->
    <aside class="filters">
        <h4>Фильтры</h4>
        <form method="get">
            <!-- Категория -->
            <div class="filter-item">
                <label>Категории:</label>
                <select name="category" onchange="this.form.submit()">
                    <option value="">Все</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category" selected="@(Model.SelectedCategory == category)">@category</option>
                    }
                </select>
            </div>

            <!-- Бренды -->
            <div class="filter-item">
                <label>Бренды:</label>
                <select name="brand" onchange="this.form.submit()">
                    <option value="">Все</option>
                    @foreach (var brand in Model.Brands)
                    {
                        <option value="@brand" selected="@(Model.SelectedBrand == brand)">@brand</option>
                    }
                </select>
            </div>

            <!-- Сортировка -->
            <div class="filter-item">
                <h4>Сортировка</h4>
                <select name="sortOrder" onchange="this.form.submit()">
                    <option value="">Без сортировки</option>
                    <option value="price_asc" selected="@(Model.SortOrder == "price_asc")">Цена: по возрастанию</option>
                    <option value="price_desc" selected="@(Model.SortOrder == "price_desc")">Цена: по убыванию</option>
                    <option value="name_asc" selected="@(Model.SortOrder == "name_asc")">Название: А-Я</option>
                    <option value="name_desc" selected="@(Model.SortOrder == "name_desc")">Название: Я-А</option>
                </select>
            </div>
        </form>
    </aside>

    <!-- Продукты -->
    <div class="products">
        @foreach (var product in Model.Products)
        {
            <div class="product-card">
                <img src="@product.ImageUrl" alt="@product.Name" />
                <h4>@product.Name</h4>
                <p>@product.Price руб.</p>
                <div class="warranty"><strong> Гарантия:</strong> @product.WarrantyMonths месяцев</div>
                <a href="@Url.Action("Details", "Products", new { id = product.Id })">
                    <button>Подробнее</button>
                </a>
            </div>
        }
    </div>
</div>

<script>
    const searchBox = document.getElementById('searchBox');
    const suggestions = document.getElementById('suggestions');

    searchBox.addEventListener('input', function () {
        const query = this.value;

        if (query.length < 2) {
            suggestions.innerHTML = '';
            return;
        }

        fetch(`/Products/SearchSuggestions?term=${encodeURIComponent(query)}`)
            .then(response => response.json())
            .then(data => {
                suggestions.innerHTML = '';
                data.forEach(item => {
                    const div = document.createElement('div');
                    div.className = 'list-group-item list-group-item-action';
                    div.textContent = item.name;
                    div.addEventListener('click', () => {
                        window.location.href = `/Products/Details/${item.id}`;
                    });
                    suggestions.appendChild(div);
                });
            });
    });

    // скрыть список при клике вне поля
    document.addEventListener('click', function (e) {
        if (!searchBox.contains(e.target) && !suggestions.contains(e.target)) {
            suggestions.innerHTML = '';
        }
    });
</script>
