@model List<Beltelecom.Models.Product>

@{
    ViewData["Title"] = "Избранное";
}

<h2>Избранное</h2>

@if (Model.Count == 0)
{
    <p>У вас нет избранных товаров.</p>
}
else
{
    <div class="favorite-list">
        @foreach (var product in Model)
        {
            <div class="favorite-item">
                <a href="@Url.Action("Details", "Products", new { id = product.Id })">
                    <img src="@product.ImageUrl" alt="@product.Name" class="favorite-image" />
                </a>
                <div class="favorite-info">
                    <h3><a href="@Url.Action("Details", "Products", new { id = product.Id })">@product.Name</a></h3>
                    <p>Цена: @product.Price руб.</p>
                </div>
            </div>
        }
    </div>
}
