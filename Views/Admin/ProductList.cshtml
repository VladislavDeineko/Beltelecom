@model IEnumerable<Beltelecom.Models.Product>

@{
    ViewData["Title"] = "Список товаров";
}

<h1>@ViewData["Title"]</h1>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <a href="@Url.Action("Create", "Admin")" class="btn btn-primary">Добавить новый товар</a>
    <a href="@Url.Action("ManageCategoriesAndBrands", "Admin")" class="btn btn-secondary">
        Управление категориями и брендами
    </a>
    <a href="@Url.Action("ExportToExcel", "Admin", new { search = Context.Request.Query["search"] })"
       class="btn btn-success">
        Экспорт в Excel
    </a>

    <form method="get" class="d-flex flex-grow-1" role="search" style="max-width: 500px;">
        <input type="text" name="search" class="form-control me-2" placeholder="Поиск по названию, категории или бренду..." value="@Context.Request.Query["search"]" />
        <button type="submit" class="btn btn-outline-primary">Поиск</button>
    </form>
</div>

@Html.AntiForgeryToken()
<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Название</th>
            <th>Категория</th>
            <th>Бренд</th>
            <th>Цена, руб</th>
            <th>На складе, шт</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr id="product-row-@product.Id">
                <td>@product.Name</td>
                <td>@product.Category.Name</td>
                <td>@product.Brand.Name</td>
                <td>@product.Price</td>
                <td>@product.Stock</td>
                <td>
                    <a href="@Url.Action("Edit", "Admin", new { id = product.Id })" class="btn btn-warning btn-sm">Редактировать</a>

                    <a href="#" class="btn btn-danger btn-sm"
                       data-bs-toggle="modal"
                       data-bs-target="#deleteModal"
                       data-id="@product.Id"
                       data-name="@product.Name">Удалить</a>
                    <!-- Мини форма увеличения склада -->
                    <div class="d-inline-flex align-items-center ms-1" style="max-width: 85px;">
                        <input type="number" class="form-control form-control-sm stock-input px-1" min="1" value="1"
                               data-product-id="@product.Id" style="width: 40px;" />
                        <button type="button" class="btn btn-success btn-sm add-stock-btn ms-1"
                                data-product-id="@product.Id" style="height: 25px;">
                            +
                        </button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Удаление товара</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <p>Вы уверены, что хотите удалить товар <strong id="productName"></strong>?</p>
                <input type="hidden" id="productId" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-danger">Удалить</button>
            </div>
        </div>
    </div>
</div>

<div aria-live="polite" aria-atomic="true" style="position: relative;">
    <div id="deleteToast" class="toast position-fixed bottom-0 end-0 p-3 bg-success text-white"
         role="alert" aria-live="assertive" aria-atomic="true"
         data-bs-delay="3000" data-bs-autohide="true">
        <div class="toast-body">
            Товар успешно удалён!
        </div>
    </div>
</div>

<div id="stockToast" class="toast position-fixed bottom-0 end-0 p-3 bg-info text-white"
     role="alert" aria-live="assertive" aria-atomic="true"
     data-bs-delay="3000" data-bs-autohide="true">
    <div class="toast-body">
        Количество на складе обновлено!
    </div>
</div>

@section Scripts {
    <script>
        let deleteProductId = 0;

        $('#deleteModal').on('show.bs.modal', function (event) {
            const button = $(event.relatedTarget);
            deleteProductId = button.data('id');
            const productName = button.data('name');

            $('#productId').val(deleteProductId);
            $('#productName').text(productName);
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            fetch(`/Admin/DeleteConfirmed/${deleteProductId}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                }
            })
            .then(response => {
                if (response.ok) {
                    $('#deleteModal').modal('hide');
                    document.getElementById(`product-row-${deleteProductId}`).remove();

                    // Показываем уведомление
                    const toastEl = new bootstrap.Toast(document.getElementById('deleteToast'));
                    toastEl.show();
                } else {
                    alert("Ошибка при удалении");
                }
            });
        });
    </script>
    <script>
                document.querySelectorAll('.add-stock-btn').forEach(button => {
            button.addEventListener('click', function () {
                const productId = this.dataset.productId;
                const input = document.querySelector(`.stock-input[data-product-id='${productId}']`);
                const quantity = parseInt(input.value);

                if (isNaN(quantity) || quantity <= 0) {
                    alert("Введите корректное количество");
                    return;
                }

                fetch(`/Admin/AddStock`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        productId: parseInt(productId),
                        amount: quantity
                    })
                })
                .then(response => {
                    if (!response.ok) throw new Error("Ошибка сервера");
                    return response.json();
                })
                .then(data => {
                    // Обновляем ячейку "На складе"
                    const stockCell = document.querySelector(`#product-row-${productId} td:nth-child(5)`);
                    stockCell.textContent = data.newStock;

                    // Показываем уведомление
                    const toastEl = new bootstrap.Toast(document.getElementById('stockToast'));
                    toastEl.show();

                    // Сбрасываем значение
                    input.value = 1;
                })
                .catch(error => {
                    alert("Не удалось обновить склад: " + error.message);
                });
            });
        });
    </script>
}