@model IEnumerable<Beltelecom.Models.Product>

@{
    ViewData["Title"] = "Список товаров";
}

<h1>@ViewData["Title"]</h1>

<a href="@Url.Action("Create", "Product")" class="btn btn-primary">Добавить новый товар</a>

<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Название</th>
            <th>Категория</th>
            <th>Бренд</th>
            <th>Цена</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Category.Name</td>
                <td>@product.Brand.Name</td>
                <td>@product.Price</td>
                <td>
                    <a href="@Url.Action("Edit", "Product", new { id = product.Id })" class="btn btn-warning btn-sm">Редактировать</a>

                    <a href="@Url.Action("Delete", "Product", new { id = product.Id })" class="btn btn-danger btn-sm"
                       onclick="return confirm('Вы уверены, что хотите удалить этот товар?')">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>
