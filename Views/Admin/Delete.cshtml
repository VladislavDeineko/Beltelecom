@model Beltelecom.Models.Product

@{
    ViewData["Title"] = "Удалить товар";
}

<h2>@ViewData["Title"]</h2>

<p>Вы уверены, что хотите удалить товар <strong>@Model.Name</strong>?</p>
<p>Цена: @Model.Price руб.</p>

<form method="post" asp-action="DeleteConfirmed" asp-route-id="@Model.Id">
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a href="@Url.Action("ProductList", "Product")" class="btn btn-secondary">Отмена</a>
</form>
