@model Product

@{
    ViewData["Title"] = "Добавить товар";
}

<h2 class="d-inline-flex align-items-center">
    <a href="/Admin/ProductList" class="btn btn-sm btn-outline-primary me-2" title="Назад к списку">
        <i class="bi bi-arrow-left"></i>
    </a>
    Добавить товар
</h2>

@using (Html.BeginForm("Create", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CategoryId"></label>
        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control">
            <option value="">-- Выберите категорию --</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="BrandId"></label>
        <select asp-for="BrandId" asp-items="ViewBag.Brands" class="form-control">
            <option value="">-- Выберите бренд --</option>
        </select>
        <span asp-validation-for="BrandId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Stock"></label>
        <input asp-for="Stock" class="form-control" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="InstallmentMonths"></label>
        <input asp-for="InstallmentMonths" class="form-control" />
        <span asp-validation-for="InstallmentMonths" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="WarrantyMonths"></label>
        <input asp-for="WarrantyMonths" class="form-control" />
        <span asp-validation-for="WarrantyMonths" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="ImageUrl">Изображение</label>
        <input type="file" class="form-control" id="ImageUrl" name="ImageUrl" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>

    <hr />
    <h4>Характеристики</h4>
    <div id="specifications-container"></div>

    <button type="submit" class="btn btn-primary mt-3">Сохранить</button>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            $('#CategoryId').change(function () {
                const categoryId = $(this).val();
                if (!categoryId) return;

                $.get('/Admin/GetSpecificationTemplate', { categoryId }, function (specs) {
                    let container = $('#specifications-container');
                    container.empty();

                    if (specs.length === 0) return;

                    let grouped = {};
                    specs.forEach((s, index) => {
                        if (!grouped[s.group]) grouped[s.group] = [];
                        grouped[s.group].push({ ...s, index });
                    });

                    let specIndex = 0;
                    for (const group in grouped) {
                        container.append(`<h5 class="mt-3">${group}</h5>`);
                        grouped[group].forEach(spec => {
                            container.append(`
                                <div class="form-group">
                                    <label>${spec.name}</label>
                                    <input type="text" class="form-control" name="Specifications[${specIndex}].Value" required />
                                    <input type="hidden" name="Specifications[${specIndex}].Name" value="${spec.name}" />
                                    <input type="hidden" name="Specifications[${specIndex}].Group" value="${spec.group}" />
                                </div>
                            `);
                            specIndex++;
                        });
                    }
                });
            });
        });
    </script>
}
