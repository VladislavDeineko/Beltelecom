@using Beltelecom.Models.ViewModels
@model DashboardStatsViewModel
@removeTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Статистика";
}
<div class="container mt-4 p-3 rounded shadow-sm" style="background-color: #fdfdfe; border: 1px solid #e9ecef;">
        <form id="dateRangeForm" class="mb-4">
            <div class="d-flex align-items-end gap-3 flex-wrap">
                <h3 class="mt-4">Период:</h3>
                <div>
                    <label for="startDate" class="form-label">С</label>
                </div>
                <div>
                    <input type="date" id="startDate" class="form-control" required />
                </div>
                <div>
                    <label for="endDate" class="form-label">По</label>
                </div>
                <div>
                    <input type="date" id="endDate" class="form-control" required />
                </div>
                <div>
                    <button type="submit" class="btn btn-primary">Применить</button>
                </div>
            </div>
        </form>

        <!-- Карточки с метриками -->
        <div class="row" id="metricsRow">
            <div class="col-md-3">
                <div class="card text-white bg-primary mb-3">
                    <div class="card-header">Активные заказы</div>
                    <div class="card-body">
                        <h5 class="card-title" id="activeOrders">0</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-danger mb-3">
                    <div class="card-header">Новые заказы в этом месяце</div>
                    <div class="card-body">
                        <h5 class="card-title" id="newOrdersThisMonth">0</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-warning mb-3">
                    <div class="card-header">Средний чек</div>
                    <div class="card-body">
                        <h5 class="card-title" id="averageCheck">0</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-success mb-3">
                    <div class="card-header">Общая выручка</div>
                    <div class="card-body">
                        <h5 class="card-title" id="totalRevenue">0</h5>
                    </div>
                </div>
            </div>
        </div>
        <!-- График "Выручка по месяцам" -->
        <h3 class="mt-4 text-center">График "Выручка по месяцам"</h3>
        <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8 p-3 rounded shadow-sm" style="background-color: #f8f9fa;">
            <div class="revenueByMonthChart-container">
                <canvas id="revenueByMonthChart"></canvas>
            </div>
            </div>
        </div>
        <!-- Диаграммы выручки -->
        <div class="row mb-5">
            <div class="col-md-6">
                <div class="p-3 rounded shadow-sm" style="background-color: #f8f9fa;">
                    <h4 class="text-center mt-2">Диаграмма "Выручка по категориям"</h4>
                    <div style="position: relative; height: 300px;">
                        <canvas id="categoryRevenueChart" style="display: block; margin: 0 auto;"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 rounded shadow-sm" style="background-color: #f8f9fa;">
                    <h4 class="text-center mt-2">Диаграмма "Выручка по брендам"</h4>
                    <div style="position: relative; height: 300px;">
                        <canvas id="brandRevenueChart" style="display: block; margin: 0 auto;"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Диаграммы товаров на складе -->
        <div class="row mb-5">
            <div class="col-md-6">
                <div class="p-3 rounded shadow-sm" style="background-color: #f8f9fa;">
                    <h4 class="text-center mt-2">Диаграмма "Товары на складе (по категории)"</h4>
                    <div style="position: relative; height: 300px;">
                        <canvas id="categoryStockChart" style="display: block; margin: 0 auto;"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 rounded shadow-sm" style="background-color: #f8f9fa;">
                    <h4 class="text-center mt-2">Диаграмма "Товары на складе (по бренду)"</h4>
                    <div style="position: relative; height: 300px;">
                        <canvas id="brandStockChart" style="display: block; margin: 0 auto;"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <!-- График заказов за последнюю неделю -->
        <div class="row mb-5">
            <div class="col-12">
                <div class="p-3 rounded shadow-sm" style="background-color: #f8f9fa;">
                    <h4 class="text-center mt-2">Заказы за последнюю неделю</h4>
                    <div style="position: relative; height: 400px;">
                        <canvas id="weeklyOrdersChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    <div class="mt-4">
        <button id="exportButton" class="btn btn-success">Экспортировать в Excel</button>
    </div>
</div>

