        updateCategoryStockChart('2025-01-01', '2025-05-07');
        updateBrandStockChart('2025-01-01', '2025-05-07');
    </script>
    <script>
        let weeklyOrdersChart;

        // Функция обновления графика
        function updateWeeklyOrdersChart(endDate) {
            fetch(`/Admin/GetWeeklyOrders?endDate=${endDate}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Ошибка запроса на сервер');
                    }
                    return response.json();
                })
                .then(data => {
                    console.log("Weekly orders data:", data);

                    const ctx = document.getElementById('weeklyOrdersChart').getContext('2d');

                    if (weeklyOrdersChart) {
                        weeklyOrdersChart.data.labels = data.labels;
                        weeklyOrdersChart.data.datasets[0].data = data.values;
                        weeklyOrdersChart.update();
                    } else {
                        weeklyOrdersChart = new Chart(ctx, {
                            type: 'bar',
                            data: {
                                labels: data.labels,
                                datasets: [{
                                    label: 'Количество заказов',
                                    data: data.values,
                                    backgroundColor: 'rgba(13, 110, 253, 0.7)',
                                    borderColor: 'rgba(13, 110, 253, 1)',
                                    borderWidth: 1
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                scales: {
                                    x: {
                                        title: {
                                            display: true,
                                            text: 'Дата'
                                        }
                                    },
                                    y: {
                                        beginAtZero: true,
                                        title: {
                                            display: true,
                                            text: 'Количество заказов'
                                        },
                                        ticks: {
                                            stepSize: 1
                                        }
                                    }
                                }
                            }
                        });
                    }
                });
        }

        // Обработчик формы выбора дат
        document.getElementById('dateRangeForm').addEventListener('submit', function (e) {
            e.preventDefault();

            const endDate = document.getElementById('endDate').value;
            if (!endDate) {
                alert("Пожалуйста, выберите дату.");
                return;
            }

            updateWeeklyOrdersChart(endDate); // Обновление графика
        });

        // Изначальная загрузка графика на основе текущей даты
        const today = new Date().toISOString().slice(0, 10);
        document.getElementById('endDate').value = today;
        updateWeeklyOrdersChart(today);
    </script>
    <script>
                document.getElementById('exportButton').addEventListener('click', function() {
            // Получаем значения из полей формы
            var startDate = document.getElementById('startDate').value;
            var endDate = document.getElementById('endDate').value;

            if (!startDate || !endDate) {
                alert('Пожалуйста, выберите оба значения даты.');
                return;
            }

            // Создаем ссылку для отправки запроса
            var url = `/Admin/ExportDashboardToExcel?startDate=${startDate}&endDate=${endDate}`;

            // Отправляем запрос на сервер
            window.location.href = url;
        });

    </script>
