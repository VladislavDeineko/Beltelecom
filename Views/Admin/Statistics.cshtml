@section Scripts {
    <script>
                // Общая цветовая карта для всех диаграмм
        const dynamicColorMap = {};

        // Функция генерации случайного цвета в hex
        function getRandomColor() {
            const letters = '0123456789ABCDEF';
            let color = '#';
            for (let i = 0; i < 6; i++) {
                color += letters[Math.floor(Math.random() * 16)];
            }
            return color;
        }

        function darkenHexColor(hex, factor) {
            const num = parseInt(hex.slice(1), 16);
            const r = Math.floor(((num >> 16) & 255) * (1 - factor));
            const g = Math.floor(((num >> 8) & 255) * (1 - factor));
            const b = Math.floor((num & 255) * (1 - factor));
            return `rgb(${r}, ${g}, ${b})`;
        }


        function getColorPairByLabels(labels) {
            const backgroundColors = [];
            const borderColors = [];

            labels.forEach(label => {
                if (!dynamicColorMap[label]) {
                    const baseColor = getRandomColor();
                    dynamicColorMap[label] = {
                        backgroundColor: baseColor,
                        borderColor: darkenHexColor(baseColor, 0.2)
                    };
                }
                backgroundColors.push(dynamicColorMap[label].backgroundColor);
                borderColors.push(dynamicColorMap[label].borderColor);
            });

            return { backgroundColors, borderColors };
        }

    </script>
    <script>
        document.getElementById('dateRangeForm').addEventListener('submit', function (e) {
            e.preventDefault();

            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;

            if (!startDate || !endDate) {
                alert("Пожалуйста, выберите обе даты.");
                return;
            }

            fetch(`/Admin/GetDashboardData?startDate=${startDate}&endDate=${endDate}`)
                .then(response => response.json())
                .then(data => {
                    // Обновляем карточки
                    document.getElementById('activeOrders').textContent = data.activeOrders;
                    document.getElementById('newOrdersThisMonth').textContent = data.newOrdersThisMonth;
                    document.getElementById('averageCheck').textContent = data.averageCheck.toFixed(2) + " руб."; // Форматируем для отображения
                    document.getElementById('totalRevenue').textContent = data.totalRevenue.toFixed(2) + " руб."; // Форматируем для отображения
                })
                .catch(error => console.error('Ошибка при получении данных:', error));
        });
    </script>
    <script>
        let revenueByMonthChart;

        // Функция для обновления графика
        function updateRevenueByMonthChart(startDate, endDate) {
            fetch(`/Admin/GetRevenueByMonth?startDate=${startDate}&endDate=${endDate}`)
                .then(response => response.json())
                .then(data => {
                    const ctx = document.getElementById('revenueByMonthChart').getContext('2d');
                    if (revenueByMonthChart) {
                        revenueByMonthChart.destroy();  // Удаляем старый график, если он существует
                    }
                    // Создаём новый график
                    revenueByMonthChart = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: data.months,  // Месяцы
                            datasets: [{
                                label: 'Выручка',
                                data: data.revenue,  // Данные по выручке
                                borderColor: 'rgba(75, 192, 192, 1)',
                                backgroundColor: 'rgba(75, 192, 192, 0.2)',
                                borderWidth: 2,
                                fill: true
                            }]
                        },
                        options: {
                            responsive: true,
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        stepSize: 10000,  // Шаг оси Y (можно настроить под выручку)
                                        callback: function(value) {
                                            return value + ' руб.';  // Добавляем рубли к значению
                                        }
                                    },
                                    title: {
                                        display: true,
                                        text: 'Выручка (руб.)'
                                    }
                                },
                                x: {
                                    title: {
                                        display: true,
                                        text: 'Месяц'
                                    }
                                }
                            }
                        }
                    });
                })
                .catch(error => console.error('Ошибка при загрузке данных для графика:', error));
        }

        // При изменении дат обновляем график
        document.getElementById('dateRangeForm').addEventListener('submit', function (e) {
            e.preventDefault();

            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;

            if (!startDate || !endDate) {
                alert("Пожалуйста, выберите обе даты.");
                return;
            }

            updateRevenueByMonthChart(startDate, endDate);
        });
    </script>
    <script>
        let categoryRevenueChart, brandRevenueChart;

        // Функция для обновления графика "Доход по категориям"
        function updateCategoryRevenueChart(startDate, endDate) {
            fetch(`/Admin/GetRevenueByCategory?startDate=${startDate}&endDate=${endDate}`)
                .then(response => response.json())
                .then(data => {
                    const ctxCat = document.getElementById('categoryRevenueChart').getContext('2d');
                    if (categoryRevenueChart) {
                        categoryRevenueChart.destroy();  // Удаляем старую диаграмму, если она существует
                    }

                    const { backgroundColors, borderColors } = getColorPairByLabels(data.labels);

                    // Создаём новую диаграмму
                    categoryRevenueChart = new Chart(ctxCat, {
                        type: 'pie',
                        data: {
                            labels: data.labels,  // Категории
                            datasets: [{
                                label: 'Доход по категориям',
                                data: data.data,  // Доходы по категориям
                                backgroundColor: backgroundColors,
                                borderColor: borderColors,
                                borderWidth: 1
                            }]
                        },
                        options: {
                            responsive: true,
                            plugins: {
                                legend: {
                                    position: 'top',
                                },
                                tooltip: {
                                    callbacks: {
                                        label: function (tooltipItem) {
                                            return tooltipItem.label + ': ' + tooltipItem.raw.toFixed(2) + ' руб.';  // Добавляем валюту
                                        }
                                    }
                                }
                            }
                        }
                    });
                })
                .catch(error => console.error('Ошибка при загрузке данных для графика (категории):', error));
        }

        // Функция для обновления графика "Доход по брендам"
        function updateBrandRevenueChart(startDate, endDate) {
            fetch(`/Admin/GetRevenueByBrand?startDate=${startDate}&endDate=${endDate}`)
                .then(response => response.json())
                .then(data => {
                    const ctxBrand = document.getElementById('brandRevenueChart').getContext('2d');
                    if (brandRevenueChart) {
                        brandRevenueChart.destroy();  // Удаляем старую диаграмму, если она существует
                    }
                    const { backgroundColors, borderColors } = getColorPairByLabels(data.labels);
                    // Создаём новую диаграмму
                    brandRevenueChart = new Chart(ctxBrand, {
                        type: 'pie',
                        data: {
                            labels: data.labels,  // Бренды
                            datasets: [{
                                label: 'Доход по брендам',
                                data: data.data,  // Доходы по брендам
                                backgroundColor: backgroundColors,
                                borderColor: borderColors,
                                borderWidth: 1
                            }]
                        },
                        options: {
                            responsive: true,
                            plugins: {
                                legend: {
                                    position: 'top',
                                },
                                tooltip: {
                                    callbacks: {
                                        label: function (tooltipItem) {
                                            return tooltipItem.label + ': ' + tooltipItem.raw.toFixed(2) + ' руб.';  // Добавляем валюту
                                        }
                                    }
                                }
                            }
                        }
                    });
                })
                .catch(error => console.error('Ошибка при загрузке данных для графика (бренды):', error));
        }

        // При изменении дат обновляем графики
        document.getElementById('dateRangeForm').addEventListener('submit', function (e) {
            e.preventDefault();

            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;

            if (!startDate || !endDate) {
                alert("Пожалуйста, выберите обе даты.");
                return;
            }

            updateCategoryRevenueChart(startDate, endDate);
            updateBrandRevenueChart(startDate, endDate);
        });
                // Изначальная загрузка графиков с текущими датами
        updateCategoryRevenueChart('2024-01-01', '2025-05-07');
        updateBrandRevenueChart('2024-01-01', '2025-05-07');
    </script>
