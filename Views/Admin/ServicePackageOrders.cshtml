@using Beltelecom.Models.ViewModels
@model List<ServicePackageOrderViewModel>

@{
    ViewData["Title"] = "Заявки на смену пакета услуг";
}

<h1>@ViewData["Title"]</h1>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <form method="get" class="d-flex flex-grow-1" role="search" style="max-width: 500px;">
        <input type="text" name="search" class="form-control me-2" placeholder="Поиск по ФИО или номеру телефона..." value="@Context.Request.Query["search"]" />
        <button type="submit" class="btn btn-outline-primary">Поиск</button>
    </form>
</div>

@Html.AntiForgeryToken()
<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Пользователь</th>
            <th>Телефон</th>
            <th>Текущий</th>
            <th>Новый</th>
            <th>Цена/мес</th>
            <th>Дата заявки</th>
            <th>Подтверждена</th>
            <th>Завершена</th>
            <th>Дата завершения</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (item.UserDealInfo != null)
                    {
                        <span>@item.UserDealInfo.LastName @item.UserDealInfo.FirstName @item.UserDealInfo.MiddleName</span>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
                <td>@item.UserDealInfo?.PhoneNumber</td>
                <td>@item.UserDealInfo.ServicePackage?.Name</td>
                <td>@item.Order.ServicePackage?.Name</td>
                <td>@item.Order.PricePerMonth руб.</td>
                <td>@item.Order.OrderDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    @if (item.Order.IsConfirmed)
                    {
                        <span class="badge bg-success">Да</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Нет</span>
                    }
                </td>
                <td>
                    @if (item.Order.IsCompleted)
                    {
                        <span class="badge bg-primary">Да</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Нет</span>
                    }
                </td>
                <td>
                    @if (item.Order.CompletedDate.HasValue)
                    {
                        @item.Order.CompletedDate.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
                <td>
                    <a href="@Url.Action("MarkAsCompleted", "Admin", new { id = item.Order.Id })" class="btn btn-success btn-sm">
                        Завершить
                    </a>
                    <a href="#" class="btn btn-danger btn-sm"
                       data-bs-toggle="modal"
                       data-bs-target="#deleteModal"
                       data-id="@item.Order.Id"
                       data-client="@item.UserDealInfo.LastName @item.UserDealInfo.FirstName @item.UserDealInfo.MiddleName"
                       data-name="@item.Order.ServicePackage?.Name">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Удаление заявки</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <p>Вы уверены, что хотите удалить заявку пользователя <strong id="orderClientName"></strong> на пакет <strong id="orderPackageName"></strong>?</p>
                <input type="hidden" id="orderId" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" id="confirmDeleteOrderBtn" class="btn btn-danger">Удалить</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');
            var name = button.getAttribute('data-name');
            var client = button.getAttribute('data-client');

            var modalBody = deleteModal.querySelector('#orderPackageName');
            modalBody.textContent = name;

            var modalBody2 = deleteModal.querySelector('#orderClientName');
            modalBody2.textContent = client;

            var orderIdInput = deleteModal.querySelector('#orderId');
            orderIdInput.value = id;
        });

        document.getElementById("confirmDeleteOrderBtn").addEventListener("click", function () {
            var orderId = document.getElementById("orderId").value;
            fetch(`/Admin/DeleteServiceOrder/${orderId}`, {
                method: "POST",
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            }).then(response => {
                if (response.ok) {
                    location.reload();
                }
            });
        });
    </script>
}
