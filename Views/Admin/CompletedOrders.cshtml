@using Beltelecom.Models.ViewModels
@model List<IncomingOrderViewModel>

@{
    ViewData["Title"] = "Завершённые заказы";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="@ViewContext.RouteData.Values["action"]" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Поиск по ФИО">
        <button type="submit" class="btn btn-primary">Поиск</button>
    </div>
</form>

<div class="order-sort">
    <a asp-action="IncomingOrders" asp-route-sortOrder="@ViewData["DateSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]">
        Сортировать
    </a>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ФИО</th>
            <th>Товар</th>
            <th>Сумма</th>
            <th>Дата заказа</th>
            <th>Дата завершения</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.Order.Product?.Name</td>
                <td>@item.Order.TotalAmount руб.</td>
                <td>@item.Order.OrderDate.ToString("dd.MM.yyyy")</td>
                <td>@item.Order.CompletedDate?.ToString("dd.MM.yyyy")</td>
            </tr>
        }
    </tbody>
</table>
