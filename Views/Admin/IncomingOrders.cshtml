@using Beltelecom.Models.ViewModels
@model List<IncomingOrderViewModel>
@removeTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Входящие заказы";
    var selectedMonth = ViewData["SelectedMonth"] as int? ?? DateTime.Now.Month;
    var selectedYear = ViewData["SelectedYear"] as int? ?? DateTime.Now.Year;
    var currentFilter = ViewData["CurrentFilter"] as string;
}

<h1>Входящие заказы</h1>

<form asp-action="IncomingOrders" method="get" class="mb-3 d-flex">
    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control me-2" placeholder="Поиск по ФИО" />
    <button type="submit" class="btn btn-primary">Поиск</button>
</form>

<form method="get" asp-action="IncomingOrders" class="form-inline mb-3">
    <div class="form-group">
        <label for="month" class="mr-2">Месяц</label>
        <select id="month" name="month" class="form-control2 form-control-sm">
            @{
                var monthNames = System.Globalization.CultureInfo.GetCultureInfo("ru-RU").DateTimeFormat.MonthNames;
                for (int i = 1; i <= 12; i++)
                {
                    <option value="@i" @(i == selectedMonth ? "selected" : "")>@monthNames[i - 1]</option>
                }
            }
        </select>
    </div>

    <div class="form-group ml-3">
        <label for="year" class="mr-2">Год</label>
        <select id="year" name="year" class="form-control2 form-control-sm">
            @{
                var currentYearValue = DateTime.Now.Year;
                for (int y = currentYearValue; y >= currentYearValue - 5; y--)
                {
                    <option value="@y" @(y == selectedYear ? "selected" : "")>@y</option>
                }
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary ml-3">Фильтровать</button>
</form>

<form method="get" asp-action="ExportIncomingOrders">
    <input type="hidden" name="searchString" value="@currentFilter" />
    <input type="hidden" name="month" value="@selectedMonth" />
    <input type="hidden" name="year" value="@selectedYear" />
    <button type="submit" class="btn btn-success mb-3">Экспорт в Excel</button>
</form>

<div class="order-sort">
    <a asp-action="IncomingOrders" asp-route-sortOrder="@ViewData["DateSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]">
        Сортировать
    </a>
</div>


<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ФИО</th>
            <th>Телефон</th>
            <th>Товар</th>
            <th>Сумма</th>
            <th>Дата заказа</th>
            <th>Рассрочка</th>
            <th>Настройка</th>
            <th>Действия</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.PhoneNumber</td>
                <td>@item.Order.Product.Name</td>
                <td>@item.Order.TotalAmount.ToString("0.00") руб.</td>
                <td>@item.Order.OrderDate.ToString("dd.MM.yyyy")</td>
                <td>
                    @if (item.Order.InstallmentMonths > 0)
                    {
                        @($"{item.Order.InstallmentMonths} мес.")
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td>
                    @(item.Order.RequiresSetup ? "Да" : "Нет")
                </td>
                <td class="text-center">
                    <div class="d-flex justify-content-center gap-2">
                        <form asp-action="ApproveOrder" asp-route-id="@item.Order.Id" method="post">
                            <button type="submit" class="btn btn-success btn-sm" title="Активировать">
                                Активировать
                            </button>
                        </form>
                        <button type="button" class="btn btn-outline-danger btn-sm" title="Удалить"
                                data-bs-toggle="modal" data-bs-target="#deleteModal"
                                onclick="setDeleteUrl(@item.Order.Id)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </td>

            </tr>
        }
    </tbody>
</table>
<!-- Модальное окно для подтверждения удаления -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Подтверждение удаления</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                Вы уверены, что хотите удалить этот заказ?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отменить</button>
                <form id="deleteForm" method="post">
                    <button type="submit" class="btn btn-danger">Удалить</button>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    function setDeleteUrl(orderId) {
        var deleteUrl = '@Url.Action("DeleteOrder", "Admin", new { id = "__orderId__" })';
        deleteUrl = deleteUrl.replace("__orderId__", orderId);
        document.getElementById("deleteForm").action = deleteUrl;
    }
</script>
