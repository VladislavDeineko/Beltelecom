@using Beltelecom.Models.ViewModels
@model List<IncomingOrderViewModel>

@{
    ViewData["Title"] = "Входящие заказы";
}

<h1>Входящие заказы</h1>

<form asp-action="IncomingOrders" method="get" class="mb-3 d-flex">
    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control me-2" placeholder="Поиск по ФИО" />
    <button type="submit" class="btn btn-primary">Поиск</button>
</form>

<div class="order-sort">
    <a asp-action="IncomingOrders" asp-route-sortOrder="@ViewData["DateSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]">
        Сортировать
    </a>
</div>


<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ФИО</th>
            <th>Товар</th>
            <th>Сумма</th>
            <th>Дата заказа</th>
            <th>Рассрочка</th>
            <th>Настройка</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.Order.Product.Name</td>
                <td>@item.Order.TotalAmount.ToString("0.00") руб.</td>
                <td>@item.Order.OrderDate.ToString("dd.MM.yyyy")</td>
                <td>
                    @if (item.Order.InstallmentMonths > 0)
                    {
                        @($"{item.Order.InstallmentMonths} мес.")
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td>
                    @(item.Order.RequiresSetup ? "Да" : "Нет")
                </td>
                <td>
                    <form asp-action="ApproveOrder" asp-route-id="@item.Order.Id" method="post">
                        <button type="submit" class="btn btn-success btn-sm">Активировать</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
