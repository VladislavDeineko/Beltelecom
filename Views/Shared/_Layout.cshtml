<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Белтелеком</title>
    <link rel="shortcut icon"
          href="./assets/favicon.ico"
          type="image/x-icon" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Beltelecom.styles.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body class="d-flex flex-column" style="height: 100vh;">
    <header class="navbar-sticky">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src ="~/assets/favicon.png" class="img-home" alt="Alternate Text" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav w-100">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Catalog" asp-action="Index">Каталог</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="ServicePackages" asp-action="Index">Пакеты услуг</a></li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">О нас</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Админ-панель</a></li>
                        }
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item ms-auto"><a class="nav-link" asp-controller="Favorites" asp-action="Index">Избранное</a></li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Profile" asp-action="Index">Личный кабинет</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-auto"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Войти</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4 flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="footer-container">
            <div class="footer-section footer-section--info">
                <a href="https://www.beltelecom.by" target="_blank" class="footer-brand">
                    РУП «Белтелком». УНП 101007741
                </a>
                <p class="footer-copyright">&copy; 2025 "РУП" Белтелеком. Все права защищены.</p>
            </div>

            <div class="footer-section footer-section--contacts">
                <div class="footer-contact">
                    <i class="bi bi-telephone footer-contact__icon"></i>
                    <span class="footer-contact__text">123 — служба поддержки</span>
                </div>
            </div>

            <div class="footer-section footer-section--documents">
                <a href="https://www.beltelecom.by/sites/default/files/content/poryadokokazaniirasrochkifizlicam2021.pdf"
                   target="_blank" class="footer-document">
                    <i class="bi bi-file-earmark-text"></i> Порядок рассрочки
                </a>
                <a href="/assets/files/tipovoi-dogovor-rassrochka.doc"
                   target="_blank" class="footer-document">
                    <i class="bi bi-file-earmark-word"></i> Типовой договор
                </a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
