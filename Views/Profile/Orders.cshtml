@model List<Beltelecom.Models.Order>

@{
    ViewData["Title"] = "Мои покупки";
}

<h2>Мои покупки</h2>

@if (Model.Any())
{
    <table class="table table-bordered mt-3">
        <thead class="thead-dark">
            <tr>
                <th>Дата заказа</th>
                <th>Общая сумма</th>
                <th>Товары</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@order.TotalAmount руб.</td>
                    <td>
                        <ul>
                            @foreach (var item in System.Text.Json.JsonSerializer.Deserialize<List<OrderItem>>(order.ItemsJson))
                            {
                                <li>@item.ProductId (Цена: @item.Price руб., Кол-во: @item.Quantity)</li>
                            }
                        </ul>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>У вас пока нет заказов.</p>
}
